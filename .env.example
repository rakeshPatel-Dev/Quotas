# Google OAuth Client Credentials
# Create an "Installed Application" (Desktop) OAuth client in Google Cloud Console
# with scopes: openid, userinfo.email, cloud-platform and a loopback redirect URI.
ANTIGRAVITY_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ANTIGRAVITY_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Optional Application Overrides
# ANTIGRAVITY_TRACKER_DATA_DIR=~/.antigravity-quota-tracker
# ANTIGRAVITY_TRACKER_DEV=1
